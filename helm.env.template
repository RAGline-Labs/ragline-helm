# RAGline Helm Environment Variables Template
# Copy this file to helm.env and fill in your actual values
# DO NOT commit helm.env to version control!
#
# Optional deploy tuning (helm-install.sh / helm-upgrade.sh):
#   export HELM_NAMESPACE=ragline
#   export HELM_RELEASE=ragline

# Azure DevOps Configuration
export AZDO_ORG="https://dev.azure.com/YOUR_ORG"
export AZDO_TOKEN="YOUR_AZURE_DEVOPS_TOKEN"
export AZURE_DEVOPS_ORG="YOUR_ORG"  # Organization name only (without full URL)

# GitHub Configuration  
export GITHUB_TOKEN="YOUR_GITHUB_PAT_TOKEN"
export GITHUB_PAT="YOUR_GITHUB_PAT_TOKEN"  # PAT with read:packages scope (SSO enabled)
export GITHUB_ORG="YOUR_GITHUB_ORG"  # GitHub organization name
export GITHUB_ORGS="YOUR_GITHUB_ORG"

# Azure DevOps PAT (for agent service)
export AZURE_DEVOPS_PAT="YOUR_AZURE_DEVOPS_PAT"

# M365 Configuration
export M365_TENANT_ID="YOUR_M365_TENANT_ID"
export M365_CLIENT_ID="YOUR_M365_CLIENT_ID"
export M365_CLIENT_SECRET="YOUR_M365_CLIENT_SECRET"
export M365_USERNAME="YOUR_M365_USERNAME"
export M365_PASSWORD="YOUR_M365_PASSWORD"
export M365_SHAREPOINT_HOST="YOUR_SHAREPOINT_HOST"
export M365_SITE_PATH="YOUR_SHAREPOINT_SITE_PATH"

# OpenAI Configuration
export OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Azure OpenAI Configuration (optional)
export AZURE_OPENAI_API_KEY=""
export AZURE_OPENAI_ENDPOINT=""

# Entra ID Configuration
export ENTRA_ID_CLIENT_SECRET="YOUR_ENTRA_CLIENT_SECRET"

# Container Registry Credentials (GHCR)
export GHCR_USERNAME="vtruong-daedatech"  # GitHub username
export GHCR_TOKEN="$GITHUB_PAT"         # Use the PAT with read:packages

# Optional: SaaS control plane (see docs/ragline-saas-bootstrap.md)
# export MONGODB_URI="mongodb://user:pass@host:27017/ragline"
# export ENCRYPTION_KEY=""   # Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# export RAGLINE_SAAS_ENABLED="false"   # default is on; set false to disable /saas handler behavior
